# Copy to .env for local development. Never commit real .env files.
# Per-environment files: .env.development, .env.staging, .env.production
# (load one with: npx nuxt build --dotenv .env.staging)

# Public values only: everything prefixed NUXT_PUBLIC_ is shipped to the browser.
# DummyJSON is a temporary public mock API; point this at the real backend when it is ready.
NUXT_PUBLIC_API_BASE=https://dummyjson.com

# Canonical site URL (sitemap, robots, SEO metadata).
# Leave empty locally; required on staging and production, e.g. https://example.uz
NUXT_SITE_URL=
